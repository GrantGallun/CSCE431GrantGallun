<% content_for :title, "Book Collection" %>

<h1>Book Collection</h1>

<table id="books">
  <thead>
    <tr>
      <th>Title</th>
      <th>Author</th>
      <th>Price</th>
      <th>Published</th>
      <th colspan="3">Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @books.each do |book| %>
      <tr id="<%= dom_id book %>">
        <td><%= book.title %></td>
        <td><%= book.author %></td>
        <td><%= number_to_currency(book.price) %></td>
        <td><%= book.published_date&.to_fs(:published) %></td>
        <td><%= link_to "Show", book %></td>
        <td><%= link_to "Edit", edit_book_path(book) %></td>
        <td><%= link_to "Delete", delete_book_path(book) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to "Add a Book", new_book_path, class: "button" %></p>
