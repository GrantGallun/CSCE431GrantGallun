# Keep LF line endings so scripts in bin/ run inside Linux containers and on Heroku.
* text=auto eol=lf
*.png binary
*.jpg binary
*.pdf binary

# Mark the database schema as having been generated.
db/schema.rb linguist-generated

# Mark any vendored files as having been vendored.
vendor/* linguist-vendored
config/credentials/*.yml.enc diff=false
config/credentials.yml.enc diff=false
